# Copy to .env and fill in real values. Never commit .env itself.

# Same database as Eclat (storefront) — PRD §11A: one API, one database.
# Migrations are owned by the Eclat repo; never run `prisma migrate` here.
DATABASE_URL=postgresql://user:password@localhost:5432/eclat

NODE_ENV=development
PORT=4000

# openssl rand -hex 48 — use a DIFFERENT secret than the storefront's
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Seed-only — used by `npm run db:seed` to create the one admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# S3 image upload — AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY aren't read by our
# own code, the AWS SDK's default credential chain picks them up automatically
# from these exact env var names (or skip them and use `aws configure` / an
# IAM role instead).
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated origins allowed to call this API from a browser
CORS_ORIGIN=http://localhost:5173
